{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(for file in assets/scripts/components/heroes/*.ts)",
      "Bash(do echo \"=== $file ===\")",
      "Bash(grep:*)",
      "Bash(done)",
      "Bash(npx tsc:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/shiyuanchen/Project/CatProtectPlanMingame/.claude/hooks/mcp-security-scan.sh"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/shiyuanchen/Project/CatProtectPlanMingame/.claude/hooks/subagent-context-injector.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/shiyuanchen/Project/CatProtectPlanMingame/.claude/hooks/notify.sh input"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/shiyuanchen/Project/CatProtectPlanMingame/.claude/hooks/notify.sh complete"
          }
        ]
      }
    ]
  }
}
